# Copie este archivo como .env y cambie los valores:
#   Windows:        copy .env.example .env
#   Linux / Mac:    cp .env.example .env
# El archivo .env NO se sube a git.

# Base de datos
PG_DATABASE=calculadora_ahorro
PG_USER=ahorro
PG_PASSWORD=cambie_esta_contrasena

# Contraseña del usuario "admin" que crea el seeding (se guarda con hash)
ADMIN_PASSWORD=cambie_esta_clave_admin

# DockerHub: su usuario y la versión de las imágenes
DOCKERHUB_USER=su_usuario_dockerhub
VERSION=1.0.0
